    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jest": "^30.1.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node"
  }
