generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id              String           @id @default(uuid()) @db.Uuid
  amount          Decimal          @db.Decimal(19, 4)
  currency        String           @db.VarChar(3)
  customerId      String           @db.VarChar(255)
  status          TransactionStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  paymentAttempts PaymentAttempt[]
  recoveryActions RecoveryAction[]
  decisionAudits  RecoveryDecisionAudit[]
  feedbackRecords RecoveryFeedback[]
  recoveryJobs    RecoveryJob[]

  @@index([customerId])
}

model PaymentAttempt {
  id              String        @id @default(uuid()) @db.Uuid
  transactionId   String        @db.Uuid
  paymentMethod   PaymentMethod
  status          AttemptStatus
  failureCategory FailureCategory?
  failureReason   String?
  attemptNumber   Int
  createdAt       DateTime      @default(now())
  transaction     Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recoveryAction  RecoveryAction?
  decisionAudits  RecoveryDecisionAudit[]
  feedbackTriggers RecoveryFeedback[] @relation("FeedbackTriggerAttempt")
  feedbackExecutions RecoveryFeedback[] @relation("FeedbackExecutionAttempt")
  recoveryJobs     RecoveryJob[]

  @@index([transactionId])
  @@unique([transactionId, attemptNumber])
}

model RecoveryAction {
  id            String               @id @default(uuid()) @db.Uuid
  transactionId String               @db.Uuid
  attemptId     String               @db.Uuid
  actionType    RecoveryActionType
  reason        String
  status        RecoveryActionStatus @default(RECOMMENDED)
  createdAt     DateTime             @default(now())
  transaction   Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  attempt       PaymentAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  decisionAudits RecoveryDecisionAudit[]
  feedbackRecords RecoveryFeedback[]
  recoveryJobs    RecoveryJob[]

  @@index([transactionId])
  @@unique([attemptId])
}

model RecoveryJob {
  id               String            @id @default(uuid()) @db.Uuid
  jobId            String            @unique @db.VarChar(255)
  transactionId    String            @db.Uuid
  recoveryActionId String            @db.Uuid
  triggerAttemptId String            @db.Uuid
  request          Json
  status           RecoveryJobStatus @default(QUEUED)
  attemptCount     Int               @default(0)
  availableAt      DateTime          @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  leaseUntil       DateTime?
  lastError        String?
  idempotencyKey   String            @unique @db.VarChar(255)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  transaction      Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recoveryAction   RecoveryAction    @relation(fields: [recoveryActionId], references: [id], onDelete: Cascade)
  triggerAttempt   PaymentAttempt    @relation(fields: [triggerAttemptId], references: [id], onDelete: Cascade)

  @@unique([recoveryActionId])
  @@index([status, availableAt])
  @@index([leaseUntil])
  @@index([transactionId])
}

model RecoveryDecisionAudit {
  id                    String             @id @default(uuid()) @db.Uuid
  auditId               String             @unique @db.VarChar(255)
  transactionId         String             @db.Uuid
  attemptId             String             @db.Uuid
  recoveryActionId      String?            @db.Uuid
  decisionTimestamp     DateTime
  selectedAction        RecoveryActionType
  decisionSource        DecisionSource
  decisionReason        String
  selectedProbability   Decimal?           @db.Decimal(8, 6)
  context               Json
  candidates            Json
  rejectedCandidates    Json
  fallback              Json
  versions              Json
  performance           Json
  explanation           Json
  explanationSchemaVersion String          @db.VarChar(50)
  createdAt             DateTime            @default(now())
  transaction           Transaction         @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  attempt               PaymentAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  recoveryAction        RecoveryAction?    @relation(fields: [recoveryActionId], references: [id], onDelete: SetNull)

  @@index([transactionId, decisionTimestamp])
  @@index([attemptId])
  @@index([recoveryActionId])
  @@index([decisionSource, decisionTimestamp])
  @@index([selectedAction, decisionTimestamp])
}

model RecoveryFeedback {
  id                    String                 @id @default(uuid()) @db.Uuid
  feedbackId            String                 @unique @db.VarChar(255)
  transactionId         String                 @db.Uuid
  triggerAttemptId      String                 @db.Uuid
  recoveryActionId      String?                @db.Uuid
  executionAttemptId    String?                @db.Uuid
  auditId               String?                @db.VarChar(255)
  feedbackTimestamp     DateTime
  outcomeTimestamp      DateTime
  selectedAction        RecoveryActionType
  decisionSource        DecisionSource
  probability           Decimal?               @db.Decimal(8, 6)
  modelVersion          String?                @db.VarChar(255)
  executionOutcome      RecoveryFeedbackOutcome
  actualRecoverySuccess Boolean?
  context               Json
  decisionMetadata      Json
  executionMetadata     Json
  versions              Json
  deduplicationKey      String                 @unique @db.VarChar(768)
  createdAt             DateTime               @default(now())
  transaction           Transaction            @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  triggerAttempt        PaymentAttempt        @relation("FeedbackTriggerAttempt", fields: [triggerAttemptId], references: [id], onDelete: Cascade)
  recoveryAction        RecoveryAction?       @relation(fields: [recoveryActionId], references: [id], onDelete: SetNull)
  executionAttempt      PaymentAttempt?       @relation("FeedbackExecutionAttempt", fields: [executionAttemptId], references: [id], onDelete: SetNull)

  @@index([transactionId, feedbackTimestamp])
  @@index([recoveryActionId])
  @@index([triggerAttemptId])
  @@index([executionAttemptId])
  @@index([decisionSource, feedbackTimestamp])
  @@index([executionOutcome, outcomeTimestamp])
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  RECOVERED
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
}

enum AttemptStatus {
  SUCCESS
  FAILED
}

enum FailureCategory {
  TEMPORARY_FAILURE
  PAYMENT_METHOD_FAILURE
  CUSTOMER_ACTION_REQUIRED
  UNKNOWN_FAILURE
}

enum RecoveryActionType {
  RETRY
  ALTERNATE_METHOD
  CUSTOMER_ACTION
  ESCALATE
}

enum RecoveryActionStatus {
  RECOMMENDED
  EXECUTED
  SUCCESS
  FAILED
}

enum DecisionSource {
  ML
  RULE
}

enum RecoveryFeedbackOutcome {
  SUCCESS
  FAILED
  EXECUTED
}

enum RecoveryJobStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
}
